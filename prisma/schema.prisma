generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum ViewMode {
  AUTO
  MOBILE
  PC
}

model Company {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  order       Int      @default(0)
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teams       Team[]
  users       User[]

  @@index([companyId])
}

model Team {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  order        Int        @default(0)
  active       Boolean    @default(true)
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  users        User[]

  @@index([departmentId])
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  employeeCode      String?        @unique
  name              String
  departmentId      String?
  department        Department?    @relation(fields: [departmentId], references: [id])
  teamId            String?
  team              Team?          @relation(fields: [teamId], references: [id])
  status            UserStatus     @default(ACTIVE)
  hiredAt           DateTime?
  retiredAt         DateTime?
  iconUrl           String?
  displayOrder      Int            @default(0)
  preferredViewMode ViewMode       @default(AUTO)
  mustChangePassword Boolean       @default(true)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  version           Int            @default(1)
  deletedAt         DateTime?

  roles             UserRole[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]

  @@index([departmentId])
  @@index([teamId])
}

model Role {
  id          String       @id @default(uuid())
  code        String       @unique // SUPER_ADMIN, ADMIN, MANAGER, LEADER, INSIDE_SALES, FIELD_SALES, ENTRY_OPERATOR, USER, VIEWER
  name        String
  description String?
  createdAt   DateTime     @default(now())
  permissions Permission[]
  users       UserRole[]
}

model Permission {
  id       String @id @default(uuid())
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String // toss_case, appointment, visit, contract, entry, user, master, system ...
  action   String // view, create, edit, delete, export, import
  scope    String // OWN, TEAM, DEPT, ALL

  @@unique([roleId, resource, action])
  @@index([roleId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  createdByIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  ipAddress    String?
  userAgent    String?
  targetType   String?
  targetId     String?
  before       Json?
  after        Json?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  key   String @id
  value Json
}

// ============================================================
// Phase3: 案件管理(顧客/トス/アポ/訪問/成約/エントリー)
// ============================================================

enum MeetingType {
  VISIT
  GOOGLE_MEET
  PHONE
  OTHER
}

enum SyncStatus {
  NOT_SYNCED
  SYNCING
  SYNCED
  ERROR
}

// 案件番号(TOS-202608-000001等)の競合を防ぐためのトランザクション採番テーブル
model SequenceCounter {
  key       String @id // 例: "TOS-202608"
  lastValue Int    @default(0)
}

model Product {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)
  order  Int     @default(0)
}

model Source {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)
  order  Int     @default(0)
}

model StatusMaster {
  id           String  @id @default(uuid())
  category     String // TOSS / APPOINTMENT / VISIT / MATCHING / ENTRY
  internalCode String // 自動処理判定用の固定コード(表示名変更の影響を受けない)
  displayName  String
  color        String?
  order        Int     @default(0)
  active       Boolean @default(true)

  @@unique([category, internalCode])
  @@index([category])
}

model Customer {
  id            String   @id @default(uuid())
  corporateName String?
  contactName   String?
  phone         String?
  email         String?
  postalCode    String?
  address       String?
  building      String?
  memo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  version       Int      @default(1)
  deletedAt     DateTime?

  tossCases    TossCase[]

  @@index([phone])
  @@index([email])
  @@index([corporateName])
}

model TossCase {
  id                   String    @id @default(uuid())
  caseNumber           String    @unique
  receivedAt           DateTime  @default(now())
  googleFormResponseId String?
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id])
  productId            String?
  sourceId             String?
  snapshotDepartmentId String?
  snapshotTeamId       String?
  tossUserId           String?
  salesUserId          String?
  fieldSalesUserId     String?
  desiredAt            DateTime?
  confirmedStartAt     DateTime?
  confirmedEndAt       DateTime?
  statusId             String
  memo                 String?
  tags                 String[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?
  version              Int       @default(1)
  deletedAt            DateTime?

  appointment          Appointment?

  @@index([statusId])
  @@index([tossUserId])
  @@index([salesUserId])
  @@index([snapshotDepartmentId])
  @@index([snapshotTeamId])
  @@index([receivedAt])
}

model Appointment {
  id                     String     @id @default(uuid())
  caseNumber             String     @unique
  tossCaseId             String?    @unique
  tossCase               TossCase?  @relation(fields: [tossCaseId], references: [id])
  customerId             String?
  snapshotDepartmentId   String?
  snapshotTeamId         String?
  apoUserId              String?
  meetingUserId          String?
  fieldSalesUserId       String?
  meetingStartAt         DateTime?
  meetingEndAt           DateTime?
  meetingType            MeetingType @default(VISIT)
  visitAddress           String?
  meetingUrl             String?
  googleCalendarEventId  String?
  calendarSyncStatus     SyncStatus  @default(NOT_SYNCED)
  calendarSyncError      String?
  meetingStatusId        String
  meetingResultId        String?
  nextActionAt           DateTime?
  memo                   String?
  idempotencyKey         String     @unique
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  createdBy              String?
  updatedBy              String?
  version                Int        @default(1)
  deletedAt              DateTime?

  visits                 Visit[]
  contract               Contract?

  @@index([meetingStatusId])
  @@index([apoUserId])
  @@index([meetingStartAt])
  @@index([snapshotDepartmentId])
  @@index([snapshotTeamId])
}

model Visit {
  id                             String    @id @default(uuid())
  caseNumber                     String    @unique
  appointmentId                  String
  appointment                    Appointment @relation(fields: [appointmentId], references: [id])
  visitKind                      String    @default("INITIAL") // INITIAL/REVISIT/FINAL_CHECK
  fieldSalesUserId               String?
  scheduledAt                    DateTime
  statusId                       String
  departedAt                     DateTime?
  arrivedAt                      DateTime?
  arrivedByUserId                String?
  arrivedLatitude                Float?
  arrivedLongitude               Float?
  arrivedAccuracy                Float?
  arrivedDistanceFromDestination Float?
  arrivedDeviceInfo              String?
  arrivedIpAddress               String?
  arrivedComment                 String?
  locationPermissionStatus       String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  version                        Int       @default(1)
  deletedAt                      DateTime?

  meetingSession                 MeetingSession?
  statusHistory                  VisitStatusHistory[]

  @@index([appointmentId])
  @@index([statusId])
  @@index([fieldSalesUserId])
  @@index([scheduledAt])
}

model VisitStatusHistory {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id])
  fromStatusId String?
  toStatusId   String
  changedBy String?
  changedAt DateTime @default(now())

  @@index([visitId])
}

model MeetingSession {
  id                            String    @id @default(uuid())
  visitId                       String    @unique
  visit                         Visit     @relation(fields: [visitId], references: [id])
  meetingStartedAt              DateTime?
  meetingStartedByUserId        String?
  meetingStartLatitude          Float?
  meetingStartLongitude         Float?
  waitingMinutes                Int?
  meetingEndedAt                DateTime?
  meetingEndedByUserId          String?
  meetingDurationMinutes        Int?
  meetingResult                 String?
  nextAction                    String?
  nextActionDate                DateTime?
  nextVisitAt                   DateTime?
  meetingMemo                   String?
  customerNeeds                 String?
  rejectionReason               String?
  estimatedContractProbability  Int?
  contractExpectedDate          DateTime?
  meetingEndLatitude             Float?
  meetingEndLongitude            Float?
}

model Contract {
  id                     String    @id @default(uuid())
  caseNumber             String    @unique
  appointmentId          String    @unique
  appointment            Appointment @relation(fields: [appointmentId], references: [id])
  tossCaseId             String?
  contractUserId         String?
  contractedAt           DateTime?
  contractAmount         Decimal?  @db.Decimal(12, 2)
  revenueForecast        Decimal?  @db.Decimal(12, 2)
  feeForecast            Decimal?  @db.Decimal(12, 2)
  contractNumber         String?
  applicationNumber      String?
  matchingStatusId       String
  matchingAt             DateTime?
  switchingScheduledAt   DateTime?
  switchingAt            DateTime?
  entryStatusId          String?
  entryAt                DateTime?
  deficiencyNote         String?
  nextActionAt           DateTime?
  memo                   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?
  updatedBy              String?
  version                Int       @default(1)
  deletedAt              DateTime?

  entries                Entry[]

  @@index([matchingStatusId])
  @@index([contractUserId])
  @@index([contractedAt])
}

model Entry {
  id                 String    @id @default(uuid())
  caseNumber         String    @unique
  contractId         String
  contract           Contract  @relation(fields: [contractId], references: [id])
  entryUserId        String?
  entryAt            DateTime?
  statusId           String
  applicationNumber  String?
  deficiencyNote     String?
  resolvedAt         DateTime?
  approvedAt         DateTime?
  memo               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)
  deletedAt          DateTime?

  @@index([contractId])
  @@index([statusId])
}

model CaseComment {
  id         String   @id @default(uuid())
  entityType String // TOSS_CASE/APPOINTMENT/VISIT/CONTRACT/ENTRY/CUSTOMER
  entityId   String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CaseHistory {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  field      String
  before     Json?
  after      Json?
  changedBy  String?
  changedAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CaseAttachment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  url        String
  fileName   String
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ============================================================
// Phase4: カスタム項目・自動処理ルール
// ============================================================

model CustomFieldDefinition {
  id             String   @id @default(uuid())
  entityType     String // CUSTOMER/TOSS/APPOINTMENT/VISIT/CONTRACT/ENTRY
  fieldKey       String // 一度使ったら変更不可(再利用制限)
  label          String
  description    String?
  dataType       String // TEXT/TEXTAREA/INT/DECIMAL/CURRENCY/PHONE/EMAIL/URL/DATE/DATETIME/TIME/SELECT/MULTISELECT/CHECKBOX/USER/DEPT/TEAM/PRODUCT/FORMULA
  required       Boolean  @default(false)
  defaultValue   String?
  placeholder    String?
  validationRule Json?
  showInList     Boolean  @default(false)
  showInDetail   Boolean  @default(true)
  showInCreate   Boolean  @default(true)
  showInEdit     Boolean  @default(true)
  searchable     Boolean  @default(false)
  filterable     Boolean  @default(false)
  csvExportable  Boolean  @default(true)
  csvImportable  Boolean  @default(true)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  options        CustomFieldOption[]
  permissions    CustomFieldPermission[]

  @@unique([entityType, fieldKey])
  @@index([entityType])
}

model CustomFieldOption {
  id      String @id @default(uuid())
  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label   String
  value   String
  order   Int    @default(0)

  @@index([fieldId])
}

model CustomFieldValue {
  id            String    @id @default(uuid())
  fieldId       String
  entityType    String
  entityId      String
  textValue     String?
  numberValue   Decimal?  @db.Decimal(18, 4)
  dateValue     DateTime?
  dateTimeValue DateTime?
  booleanValue  Boolean?
  jsonValue     Json?
  updatedAt     DateTime  @updatedAt

  @@unique([fieldId, entityId])
  @@index([entityType, entityId])
}

model CustomFieldPermission {
  id       String @id @default(uuid())
  fieldId  String
  field    CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  roleId   String
  canView  Boolean @default(true)
  canEdit  Boolean @default(true)

  @@unique([fieldId, roleId])
}

model StatusAutomationRule {
  id             String  @id @default(uuid())
  statusMasterId String
  action         String // CREATE_APPOINTMENT/CREATE_CALENDAR_EVENT/CREATE_MEET/CREATE_CONTRACT/... (固定文字列)
  config         Json    @default("{}")
  active         Boolean @default(true)

  @@index([statusMasterId])
}
