generator client {
  provider      = "prisma-client-js"
  // ローカル開発(Windows/Mac等)に加え、Railway等のnode:20-alpine(OpenSSL 3系)ランタイム向けの
  // エンジンも生成する。指定しないとOpenSSL 1.1前提のエンジンになりコンテナ内で起動に失敗する。
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING // 自己登録直後、管理者の承認待ち(ログイン不可)
  ACTIVE
  SUSPENDED
  RETIRED
}

enum ViewMode {
  AUTO
  MOBILE
  PC
}

model Company {
  id          String       @id @default(uuid())
  name        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
}

model Department {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  order       Int      @default(0)
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teams       Team[]
  users       User[]

  @@index([companyId])
}

model Team {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  order        Int        @default(0)
  active       Boolean    @default(true)
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  users        User[]

  @@index([departmentId])
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  employeeCode      String?        @unique
  name              String
  departmentId      String?
  department        Department?    @relation(fields: [departmentId], references: [id])
  teamId            String?
  team              Team?          @relation(fields: [teamId], references: [id])
  status            UserStatus     @default(ACTIVE)
  hiredAt           DateTime?
  retiredAt         DateTime?
  iconUrl           String?
  displayOrder      Int            @default(0)
  preferredViewMode ViewMode       @default(AUTO)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  version           Int            @default(1)
  deletedAt         DateTime?

  roles             UserRole[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  pushSubscriptions  PushSubscription[]
  preferences        UserPreference[]

  @@index([departmentId])
  @@index([teamId])
}

// ユーザーごとのUI設定(一覧の列幅など)。全アカウント共通ではなく本人だけに紐づく。
// key例: "tableWidths:toss-cases"、value: { "<列key>": <px幅> }
model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// Google連携(カレンダー/Meet)の接続情報。単一接続(provider一意)。
// アカウントを含め、連携設定ページから後から紐づける(要望)。トークンは暗号化して保存。
model GoogleIntegration {
  id            String    @id @default(uuid())
  provider      String    @unique @default("google_calendar")
  accountEmail  String?
  accessToken   String? // 暗号化(token-crypto.util)
  refreshToken  String? // 暗号化
  tokenExpiry   DateTime?
  scope         String?
  calendarId    String    @default("primary")
  connectedById String?
  connectedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ブラウザ/PWAのWeb Push購読情報(セクション追加要望: リマインドのデスクトップ/スマホ通知)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String       @id @default(uuid())
  code        String       @unique // SUPER_ADMIN, ADMIN, MANAGER, LEADER, INSIDE_SALES, FIELD_SALES, ENTRY_OPERATOR, USER, VIEWER
  name        String
  description String?
  createdAt   DateTime     @default(now())
  permissions Permission[]
  users       UserRole[]
}

model Permission {
  id       String @id @default(uuid())
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String // toss_case, appointment, visit, contract, entry, user, master, system ...
  action   String // view, create, edit, delete, export, import
  scope    String // OWN, TEAM, DEPT, ALL

  @@unique([roleId, resource, action])
  @@index([roleId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedBy String?
  createdByIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  ipAddress    String?
  userAgent    String?
  targetType   String?
  targetId     String?
  before       Json?
  after        Json?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model SystemSetting {
  key   String @id
  value Json
}

// ============================================================
// Phase3: 案件管理(顧客/トス/アポ/訪問/成約/エントリー)
// ============================================================

enum MeetingType {
  VISIT
  GOOGLE_MEET
  PHONE
  OTHER
}

enum SyncStatus {
  NOT_SYNCED
  SYNCING
  SYNCED
  ERROR
}

// 案件番号(TOS-202608-000001等)の競合を防ぐためのトランザクション採番テーブル
model SequenceCounter {
  key       String @id // 例: "TOS-202608"
  lastValue Int    @default(0)
}

model Product {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)
  order  Int     @default(0)
}

model Source {
  id     String  @id @default(uuid())
  name   String
  active Boolean @default(true)
  order  Int     @default(0)
}

model StatusMaster {
  id           String  @id @default(uuid())
  category     String // TOSS / APPOINTMENT / VISIT / MATCHING / ENTRY
  internalCode String // 自動処理判定用の固定コード(表示名変更の影響を受けない)
  displayName  String
  color        String?
  order        Int     @default(0)
  active       Boolean @default(true)

  @@unique([category, internalCode])
  @@index([category])
}

model Customer {
  id            String   @id @default(uuid())
  corporateName String?
  contactName   String?
  phone         String?
  email         String?
  postalCode    String?
  address       String?
  building      String?
  memo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  version       Int      @default(1)
  deletedAt     DateTime?

  tossCases    TossCase[]
  appointments Appointment[]

  @@index([phone])
  @@index([email])
  @@index([corporateName])
}

model TossCase {
  id                   String    @id @default(uuid())
  caseNumber           String    @unique
  caseName             String? // 案件名(セクション追加要望: 法人名に代わり案件番号・案件名を主軸に管理する)
  receivedAt           DateTime  @default(now())
  googleFormResponseId String?
  customerId           String?
  customer             Customer? @relation(fields: [customerId], references: [id])
  productId            String?
  sourceId             String?
  snapshotDepartmentId String?
  snapshotTeamId       String?
  tossUserId           String?
  salesUserId          String?
  fieldSalesUserId     String?
  desiredAt            DateTime?
  confirmedStartAt     DateTime?
  confirmedEndAt       DateTime?
  statusId             String
  memo                 String?
  tags                 String[]

  // トス実績一覧(セクション追加要望)向け項目。Googleフォーム連携実装までは表示/手入力欄として保持する。
  apStaffName          String? // AP: アポ担当者名
  department           String? // 部署(フォーム提供の部署ラベル。snapshotDepartmentIdとは別概念)
  proposal             String? // 提案
  listName             String? // リスト
  callDirection        String? // 架電or入電
  industry             String? // 業種
  hook                 String? // フック
  existingContract     String? // 既契約
  preConfirmStatusId   String? // 前確担当者(StatusMaster category=TOSS_PRE_CONFIRM)
  progressStatusId     String? // 進捗(StatusMaster category=TOSS_PROGRESS)
  ngReasonStatusId     String? // NG理由(StatusMaster category=TOSS_NG_REASON)
  nextActionAt         DateTime? // 次回対応日+対応時間

  // 対応中フラグ(架電中ボタン)。押下で全ユーザーへリアルタイム共有し、行を赤色表示する。
  isCallingInProgress  Boolean   @default(false)
  callingByUserId      String?
  callingStartedAt     DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?
  version              Int       @default(1)
  deletedAt            DateTime?

  appointment          Appointment?

  @@index([statusId])
  @@index([tossUserId])
  @@index([salesUserId])
  @@index([snapshotDepartmentId])
  @@index([snapshotTeamId])
  @@index([receivedAt])
}

model Appointment {
  id                     String     @id @default(uuid())
  caseNumber             String     @unique
  caseName               String? // トス案件から引き継がれる(セクション追加要望)
  tossCaseId             String?    @unique
  tossCase               TossCase?  @relation(fields: [tossCaseId], references: [id])
  customerId             String?
  customer               Customer?  @relation(fields: [customerId], references: [id])
  snapshotDepartmentId   String?
  snapshotTeamId         String?
  apoUserId              String?
  meetingUserId          String?
  fieldSalesUserId       String?
  meetingStartAt         DateTime?
  meetingEndAt           DateTime?
  meetingType            MeetingType @default(VISIT)
  visitAddress           String?
  meetingUrl             String?
  googleCalendarEventId  String?
  calendarSyncStatus     SyncStatus  @default(NOT_SYNCED)
  calendarSyncError      String?
  meetingStatusId        String
  meetingResultId        String?
  nextActionAt           DateTime? // 決着予定日
  memo                   String? // 備考
  idempotencyKey         String     @unique
  calendarColor          String? // CLカレンダーでの表示色(セクション追加要望)
  reminderEnabled        Boolean    @default(false) // CLカレンダーのリマインドON/OFF(セクション追加要望)
  reminderMinutesBefore  Int? // 何分前に通知するか(例: 30)
  reminderSentAt         DateTime? // リマインド送信済み時刻(二重送信防止用)
  preContactAt           DateTime? // 前連日時(セクション追加要望: トス→アポイント変更時に入力必須、CLカレンダーへ30分予定を表示)
  // CLカレンダーの予定タイトルは「部署ラベル 都道府県頭文字【獲得角度ラベル】店舗名」で
  // 常に自動組み立てする(要望)。calendarTitleはその組み立て結果のキャッシュ(将来のGoogle
  // カレンダー連携用に保存しておくだけで、表示側は都度組み立てる)。
  calendarTitle          String?
  // 題名の【】に入るラベル。既定はトスのフック→ラベル変換の変換後ラベル、以降はプルダウンで変更可
  calendarBracketLabel   String?

  reportEvents           AppointmentReportEvent[]

  // アポ実績一覧(セクション追加要望)向け項目
  apStaffName                  String? // AP: アポ担当者名
  preConfirmStatusId           String? // 前確(StatusMaster category=TOSS_PRE_CONFIRM、トスと共有)
  preContactStatusId           String? // 前連担当(StatusMaster category=APPOINTMENT_PRE_CONTACT)
  closerStatusId                String? // CL: クロージング担当者(StatusMaster category=APPOINTMENT_CLOSER)
  hook                          String? // フック
  department                    String? // 部署
  industry                      String? // 業種
  importantMattersOkAt          DateTime? // 重説OK日
  electronicContractAt          DateTime? // ET日(電子契約完了日)
  hpProgressStatusId            String? // HP進捗(StatusMaster category=APPOINTMENT_HP_PROGRESS)
  typeStatusId                  String? // 種別(StatusMaster category=APPOINTMENT_TYPE)
  progressStatusId               String? // 進捗(StatusMaster category=APPOINTMENT_PROGRESS)
  listName                       String? // リスト
  acquisitionMethodStatusId      String? // 獲得方法(StatusMaster category=APPOINTMENT_ACQUISITION_METHOD)
  proposalLocation                String? // 提案場所
  existingContract                 String? // 既契約

  anshinBizProposed              Boolean  @default(false) // あんしんBiz(提案)
  anshinBizStatusId               String? // あんしんBiz(StatusMaster category=APPOINTMENT_ANSHIN_BIZ_STATUS)
  anshinBizLostReasonStatusId     String? // あんしんBiz失注理由(StatusMaster category=APPOINTMENT_ANSHIN_BIZ_LOST_REASON)
  anshinBizPoints                  Int?    // あんしんBiz Pt

  mobileProposed                   Boolean  @default(false) // モバイル(提案)
  mobileStatusId                    String? // モバイル(StatusMaster category=APPOINTMENT_MOBILE_STATUS)
  mobileLostReasonStatusId          String? // モバイル失注理由(StatusMaster category=APPOINTMENT_MOBILE_LOST_REASON)

  funfoProposed                     Boolean  @default(false) // funfo(提案)
  funfoStatusId                      String? // funfo(StatusMaster category=APPOINTMENT_FUNFO_STATUS)
  funfoLostReasonStatusId            String? // funfo失注理由(StatusMaster category=APPOINTMENT_FUNFO_LOST_REASON)

  deductionNote                      String? // ※減算※
  consentFormTypeStatusId            String? // 同意書種別(StatusMaster category=APPOINTMENT_CONSENT_FORM_TYPE)
  acquiredCompanyName                String? // 獲得社名
  deliveryMethodStatusId             String? // 交付方法(StatusMaster category=APPOINTMENT_DELIVERY_METHOD)
  deliveryStatusStatusId             String? // 交付状況(StatusMaster category=APPOINTMENT_DELIVERY_STATUS)
  deliveredAt                        DateTime? // 交付日
  specialNotes                       String? // メモ・特記事項(備考=memoとは別項目)

  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  createdBy              String?
  updatedBy              String?
  version                Int        @default(1)
  deletedAt              DateTime?

  visits                 Visit[]
  contract               Contract?

  @@index([meetingStatusId])
  @@index([apoUserId])
  @@index([meetingStartAt])
  @@index([snapshotDepartmentId])
  @@index([snapshotTeamId])
}

// CLカレンダーの商談(訪問/オンライン)ごとの実施報告(セクション追加要望)。
// 前連結果・訪問状況・商談結果・リスケ等をテキストで報告し、報告内容は
// Appointment.memoへも自動追記する。部署責任者(MANAGERロール)が
// 確認完了するまで通知として残り続ける。
model AppointmentReportEvent {
  id                   String    @id @default(uuid())
  appointmentId        String
  appointment          Appointment @relation(fields: [appointmentId], references: [id])
  checkpoint           String // PRE_CONTACT_RESULT/DEPARTED/ARRIVED/ARRIVED_WAITING/VISIT_RESULT/ONLINE_WAITING/ONLINE_RESULT/RESCHEDULE
  reportText           String
  reportedByUserId     String?
  reportedAt           DateTime  @default(now())
  acknowledgedByUserId String?
  acknowledgedAt       DateTime?

  @@index([appointmentId])
  @@index([acknowledgedAt])
}

model Visit {
  id                             String    @id @default(uuid())
  caseNumber                     String    @unique
  caseName                       String? // 親アポ案件から表示用にコピー(訪問固有の番号は維持)
  appointmentId                  String
  appointment                    Appointment @relation(fields: [appointmentId], references: [id])
  visitKind                      String    @default("INITIAL") // INITIAL/REVISIT/FINAL_CHECK
  fieldSalesUserId               String?
  scheduledAt                    DateTime
  statusId                       String
  destinationLatitude            Float?    // 訪問先座標(住所ジオコーディング結果。未設定時は距離警告を行わない)
  destinationLongitude           Float?
  departedAt                     DateTime?
  arrivedAt                      DateTime?
  arrivedByUserId                String?
  arrivedLatitude                Float?
  arrivedLongitude               Float?
  arrivedAccuracy                Float?
  arrivedDistanceFromDestination Float?
  arrivedDeviceInfo              String?
  arrivedIpAddress               String?
  arrivedComment                 String?
  locationPermissionStatus       String?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt
  version                        Int       @default(1)
  deletedAt                      DateTime?

  meetingSession                 MeetingSession?
  statusHistory                  VisitStatusHistory[]

  @@index([appointmentId])
  @@index([statusId])
  @@index([fieldSalesUserId])
  @@index([scheduledAt])
}

model VisitStatusHistory {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id])
  fromStatusId String?
  toStatusId   String
  changedBy String?
  changedAt DateTime @default(now())

  @@index([visitId])
}

model MeetingSession {
  id                            String    @id @default(uuid())
  visitId                       String    @unique
  visit                         Visit     @relation(fields: [visitId], references: [id])
  meetingStartedAt              DateTime?
  meetingStartedByUserId        String?
  meetingStartLatitude          Float?
  meetingStartLongitude         Float?
  waitingMinutes                Int?
  meetingEndedAt                DateTime?
  meetingEndedByUserId          String?
  meetingDurationMinutes        Int?
  meetingResult                 String?
  nextAction                    String?
  nextActionDate                DateTime?
  nextVisitAt                   DateTime?
  meetingMemo                   String?
  customerNeeds                 String?
  rejectionReason               String?
  estimatedContractProbability  Int?
  contractExpectedDate          DateTime?
  meetingEndLatitude             Float?
  meetingEndLongitude            Float?
}

model Contract {
  id                     String    @id @default(uuid())
  caseNumber             String    @unique
  caseName               String? // アポ案件から引き継がれる(セクション追加要望)
  appointmentId          String    @unique
  appointment            Appointment @relation(fields: [appointmentId], references: [id])
  tossCaseId             String?
  contractUserId         String?
  contractedAt           DateTime?
  contractAmount         Decimal?  @db.Decimal(12, 2)
  revenueForecast        Decimal?  @db.Decimal(12, 2)
  feeForecast            Decimal?  @db.Decimal(12, 2)
  contractNumber         String?
  applicationNumber      String?
  matchingStatusId       String
  matchingAt             DateTime?
  switchingScheduledAt   DateTime?
  switchingAt            DateTime?
  cancelledAt            DateTime? // キャンセル日時(ET管理・セクション追加要望)
  terminatedAt           DateTime? // 解約日時(ET管理・セクション追加要望)
  deficiencyNote         String?
  nextActionAt           DateTime?
  memo                   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  createdBy              String?
  updatedBy              String?
  version                Int       @default(1)
  deletedAt              DateTime?

  @@index([matchingStatusId])
  @@index([contractUserId])
  @@index([contractedAt])
}

model CaseComment {
  id         String   @id @default(uuid())
  entityType String // TOSS_CASE/APPOINTMENT/VISIT/CONTRACT/CUSTOMER
  entityId   String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CaseHistory {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  field      String
  before     Json?
  after      Json?
  changedBy  String?
  changedAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model CaseAttachment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  url        String
  fileName   String
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ============================================================
// Phase4: カスタム項目・自動処理ルール
// ============================================================

model CustomFieldDefinition {
  id             String   @id @default(uuid())
  entityType     String // CUSTOMER/TOSS/APPOINTMENT/VISIT/CONTRACT/ENTRY
  fieldKey       String // 一度使ったら変更不可(再利用制限)
  label          String
  description    String?
  dataType       String // TEXT/TEXTAREA/INT/DECIMAL/CURRENCY/PHONE/EMAIL/URL/DATE/DATETIME/TIME/SELECT/MULTISELECT/CHECKBOX/USER/DEPT/TEAM/PRODUCT/FORMULA
  required       Boolean  @default(false)
  defaultValue   String?
  placeholder    String?
  validationRule Json?
  showInList     Boolean  @default(false)
  showInDetail   Boolean  @default(true)
  showInCreate   Boolean  @default(true)
  showInEdit     Boolean  @default(true)
  searchable     Boolean  @default(false)
  filterable     Boolean  @default(false)
  csvExportable  Boolean  @default(true)
  csvImportable  Boolean  @default(true)
  order          Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  options        CustomFieldOption[]
  permissions    CustomFieldPermission[]
  values         CustomFieldValue[]

  @@unique([entityType, fieldKey])
  @@index([entityType])
}

model CustomFieldOption {
  id      String @id @default(uuid())
  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  label   String
  value   String
  order   Int    @default(0)

  @@index([fieldId])
}

model CustomFieldValue {
  id            String    @id @default(uuid())
  fieldId       String
  field         CustomFieldDefinition @relation(fields: [fieldId], references: [id])
  entityType    String
  entityId      String
  textValue     String?
  numberValue   Decimal?  @db.Decimal(18, 4)
  dateValue     DateTime?
  dateTimeValue DateTime?
  booleanValue  Boolean?
  jsonValue     Json?
  updatedAt     DateTime  @updatedAt

  @@unique([fieldId, entityId])
  @@index([entityType, entityId])
}

model CustomFieldPermission {
  id       String @id @default(uuid())
  fieldId  String
  field    CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  roleId   String
  canView  Boolean @default(true)
  canEdit  Boolean @default(true)

  @@unique([fieldId, roleId])
}

model StatusAutomationRule {
  id             String  @id @default(uuid())
  statusMasterId String
  action         String // CREATE_APPOINTMENT/CREATE_CALENDAR_EVENT/CREATE_MEET/CREATE_CONTRACT/... (固定文字列)
  config         Json    @default("{}")
  active         Boolean @default(true)

  @@index([statusMasterId])
}

// ============================================================
// Phase6: モバイル訪問営業(位置情報記録・オフライン同期)
// ============================================================

model LocationRecord {
  id          String   @id @default(uuid())
  visitId     String?
  eventType   String // ARRIVE/MEETING_START/MEETING_END
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  userId      String?
  capturedAt  DateTime @default(now())

  @@index([visitId])
}

model OfflineAction {
  id              String   @id @default(uuid())
  idempotencyKey  String   @unique
  userId          String
  actionType      String // ARRIVE/START_MEETING/END_MEETING/COMMENT
  targetEntityId  String
  payload         Json
  capturedAt      DateTime
  status          String   @default("PENDING") // PENDING/SYNCED/FAILED
  errorMessage    String?
  retryCount      Int      @default(0)
  createdAt       DateTime @default(now())
  syncedAt        DateTime?

  @@index([userId])
  @@index([status])
}

// Googleフォーム連携(セクション追加要望)。Apps Script側からWebhookで送られてくる回答を
// 受信原文ごと保存する。項目名(質問タイトル)からトス実績の項目名へは固定の対応表で自動変換する。
model GoogleFormWebhookLog {
  id           String   @id @default(uuid())
  responseId   String? // Googleフォーム回答ID(取得できた場合のみ。冪等性チェックに使用)
  rawPayload   Json
  status       String // RECEIVED/PROCESSED/DUPLICATE/ERROR
  tossCaseId   String? // 作成されたトス案件(成功時のみ)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([responseId])
  @@index([createdAt])
}

// ============================================================
// サマリータブ: Googleスプレッドシート風の自由編集表(セクション追加要望)
// ============================================================

// 1枚のシート(タブ)。セルは値のある箇所のみSummarySheetCellに保存する疎な構造。
// 将来的な合計/平均等の機能追加はSummarySheetCellへformula列等を足すだけで対応できる想定。
model SummarySheet {
  id        String    @id @default(uuid())
  name      String
  order     Int       @default(0)
  rowCount  Int       @default(20)
  colCount  Int       @default(10)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  cells     SummarySheetCell[]

  @@index([order])
}

model SummarySheetCell {
  id        String   @id @default(uuid())
  sheetId   String
  sheet     SummarySheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  row       Int
  col       Int
  value     String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([sheetId, row, col])
  @@index([sheetId])
}
