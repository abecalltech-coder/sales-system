FROM node:20-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY pnpm-workspace.yaml package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY prisma prisma
RUN pnpm install --frozen-lockfile=false

FROM deps AS build
COPY . .
# RailwayがRAILWAY_GIT_COMMIT_SHAをDockerビルド引数として自動注入する保証がなく、
# 実際にprisma generateレイヤーがキャッシュされ続ける事象が発生した。Railway側の
# 設定に依存せず確実にキャッシュを無効化するため、デフォルト値をこのファイル自体に
# 直接書き込む方式にする。再度キャッシュを強制的に破棄したい時は、この値
# (日付+連番など任意の文字列でよい)を書き換えてpushすること。
ARG CACHEBUST=2026-08-08.2
RUN echo "cachebust: ${CACHEBUST}" && pnpm exec prisma generate --schema prisma/schema.prisma
RUN pnpm --filter @sales-system/api build
RUN pnpm --filter @sales-system/web build

FROM node:20-alpine AS runner
RUN corepack enable
# PrismaのクエリエンジンがOpenSSLの共有ライブラリを必要とするため明示的に入れておく
# (未インストールだとlibssl.so.1.1が無く起動時にクラッシュし、ヘルスチェック失敗の原因になる)
RUN apk add --no-cache openssl
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /repo/apps/api/dist ./apps/api/dist
COPY --from=build /repo/apps/web/dist ./apps/api/web-dist
COPY --from=build /repo/prisma ./prisma
COPY --from=build /repo/scripts ./scripts
COPY --from=build /repo/apps/api/package.json ./apps/api/package.json

EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD wget -qO- http://localhost:4000/health || exit 1

# railway.jsonのstartCommandが本番では優先されるが、素のdocker runでも
# マイグレーション適用込みで起動できるよう合わせておく。
CMD ["sh", "scripts/release.sh"]
